<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tema dark. Paleta de estados: good/warning/serious/critical, siempre acompañada de icono y texto. -->
  <SolidColorBrush x:Key="Bg.Window" Color="#141413" />
  <SolidColorBrush x:Key="Bg.Card" Color="#1F1F1E" />
  <SolidColorBrush x:Key="Bg.Subtle" Color="#2A2A28" />
  <SolidColorBrush x:Key="Border.Card" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Fg.Primary" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Fg.Secondary" Color="#C3C2B7" />
  <SolidColorBrush x:Key="Fg.Muted" Color="#9C9A93" />
