<UserControl x:Class="InternetHealth.App.Controls.ChainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <!-- La cadena de conexión: el eslabón con problemas se resalta con un anillo grueso y la leyenda "Aquí falla". -->
  <ItemsControl ItemsSource="{Binding Chain}" Focusable="False" AutomationProperties.Name="Cadena de conexión">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Grid Margin="0,0,0,2" AutomationProperties.Name="{Binding AutomationName}" Focusable="True" ToolTip="{Binding AutomationName}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Conectores -->
          <Rectangle Grid.Column="0" Height="2" VerticalAlignment="Center" Fill="{DynamicResource Chart.Axis}"
                     Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVis}}" />
          <Rectangle Grid.Column="1" Height="2" VerticalAlignment="Center" Fill="{DynamicResource Chart.Axis}"
                     Visibility="{Binding IsLast, Converter={StaticResource InverseBoolToVis}}" />

          <!-- Nodo -->
          <Grid Grid.ColumnSpan="2" Width="46" Height="46" HorizontalAlignment="Center">
            <Border x:Name="Circle" CornerRadius="23" BorderThickness="2"
                    Background="{Binding Health, Converter={StaticResource HealthBrush}, ConverterParameter=Soft}"
                    BorderBrush="{Binding Health, Converter={StaticResource HealthBrush}}">
              <Path Data="{Binding Icon}" Width="24" Height="24" Stretch="None" StrokeThickness="1.7"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stroke="{DynamicResource Fg.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ContentPresenter Content="{Binding Health}" ContentTemplate="{StaticResource StatusBadge}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4" />
          </Grid>

          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Label}" Margin="2,8,2,0" FontSize="12" FontWeight="SemiBold"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg.Primary}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Margin="2,1,2,0" FontSize="11"
                     TextAlignment="Center" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Fg.Muted}" />
          <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5,0,0" HorizontalAlignment="Center" CornerRadius="4" Padding="6,1"
                  Background="{Binding Health, Converter={StaticResource HealthBrush}}"
                  Visibility="{Binding IsCulprit, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Aquí falla" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{Binding Health, Converter={StaticResource HealthBrush}, ConverterParameter=Ink}" />
          </Border>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsCulprit}" Value="True">
            <Setter TargetName="Circle" Property="BorderThickness" Value="4" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
