<Window x:Class="InternetHealth.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:InternetHealth.App.Controls"
        xmlns:vm="clr-namespace:InternetHealth.App.ViewModels"
        Title="Monitor de Conexión"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/InternetHealthMonitor;component/Assets/app.ico"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Primary}"
        FontFamily="Segoe UI" UseLayoutRounding="True">

  <Window.Resources>
    <!-- Tarjeta de métrica con minigráfica -->
    <DataTemplate x:Key="MetricCard" DataType="{x:Type vm:MetricCardViewModel}">
      <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,12">
        <StackPanel>
          <DockPanel>
            <ContentPresenter DockPanel.Dock="Right" Content="{Binding Health}" ContentTemplate="{StaticResource StatusBadge}" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Primary}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Secondary}" Style="{StaticResource Text.Body}" />
          <c:Sparkline Height="42" Margin="0,8,0,0" Values="{Binding Values}"
                       Stroke="{DynamicResource Chart.Series}" LossBrush="{DynamicResource Chart.Loss}"
                       GridBrush="{DynamicResource Chart.Grid}" TextBrush="{DynamicResource Fg.Secondary}"
                       Visibility="{Binding HasChart, Converter={StaticResource BoolToVis}}"
                       ToolTip="Últimas mediciones. Las marcas rojas en la base son respuestas perdidas." />
          <TextBlock Text="{Binding Tertiary}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                     Visibility="{Binding Tertiary, Converter={StaticResource EmptyToCollapsed}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="TabHeader" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
  </Window.Resources>

  <DockPanel>
  <!-- Modo demostración: siempre visible para no confundir la red simulada con la real -->
  <Border DockPanel.Dock="Top" Background="{DynamicResource Accent}" Padding="24,6"
          Visibility="{Binding Dashboard.IsDemo, Converter={StaticResource BoolToVis}}">
    <TextBlock Foreground="{DynamicResource Accent.Fg}" FontSize="12.5" TextWrapping="Wrap">
      <Run Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" /><Run Text="  " /><Run FontWeight="SemiBold" Text="Modo demostración:" />
      <Run Text="la red y la llamada son simuladas. Nada de lo que ves corresponde a tu conexión real." />
    </TextBlock>
  </Border>
  <Grid Margin="24,16,24,16">
    <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">

      <!-- ======================= RESUMEN ======================= -->
      <TabItem Header="Resumen" Style="{StaticResource TabHeader}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <StackPanel DataContext="{Binding Dashboard}">
            <Border Style="{StaticResource Card}" Padding="20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" VerticalAlignment="Top" Margin="0,0,16,0">
                  <Ellipse Fill="{Binding Severity, Converter={StaticResource HealthBrush}}" />
                  <TextBlock Text="{Binding Severity, Converter={StaticResource HealthGlyph}}" FontFamily="{StaticResource IconFont}" FontSize="22"
                             Foreground="{Binding Severity, Converter={StaticResource HealthBrush}, ConverterParameter=Ink}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding SeverityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Secondary}" />
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Hero}" FontSize="22" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontSize="14" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                  <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Foreground="{DynamicResource Accent}"
                             Visibility="{Binding IsImproving, Converter={StaticResource BoolToVis}}"
                             Text="Mejorando… confirmando que la conexión se mantenga estable" />
                  <TextBlock Text="{Binding CallText}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                             Visibility="{Binding InCall, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,0,0" MinWidth="200">
                  <TextBlock Text="Calidad para videollamadas" Style="{StaticResource Text.Caption}" />
                  <TextBlock Text="{Binding MosLabel}" Style="{StaticResource Text.Metric}" />
                  <TextBlock Text="{Binding MosText}" Style="{StaticResource Text.Caption}" />
                  <UniformGrid Columns="3" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="Latencia" Style="{StaticResource Text.Caption}" />
                      <TextBlock Text="{Binding LatencyText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Variación" Style="{StaticResource Text.Caption}" />
                      <TextBlock Text="{Binding JitterText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Pérdida" Style="{StaticResource Text.Caption}" />
                      <TextBlock Text="{Binding LossText}" FontWeight="SemiBold" />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,18,16,14">
              <StackPanel>
                <TextBlock Text="Cadena de conexión" Style="{StaticResource Text.Section}" Margin="0,0,0,14" />
                <c:ChainView />
              </StackPanel>
            </Border>

            <TextBlock Text="Mediciones en vivo" Style="{StaticResource Text.Section}" Margin="0,20,0,10" />
            <UniformGrid Columns="3" Margin="0,0,-12,0">
              <ContentControl Content="{Binding InternetCard}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
              <ContentControl Content="{Binding RouterCard}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
              <ContentControl Content="{Binding ProviderCard}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
              <ContentControl Content="{Binding CloudCard}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
              <ContentControl Content="{Binding LinkCard}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
              <ContentControl Content="{Binding DeviceCard}" ContentTemplate="{StaticResource MetricCard}" Focusable="False" />
            </UniformGrid>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,8">
              <Run Text="{Binding UpdatedText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ModeText, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================= HISTORIAL ======================= -->
      <TabItem Header="Historial" Style="{StaticResource TabHeader}">
        <Grid DataContext="{Binding History}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton Style="{StaticResource Button.Range}" GroupName="range" Content="1 hora" IsChecked="{Binding Range1h}" />
              <RadioButton Style="{StaticResource Button.Range}" GroupName="range" Content="6 horas" IsChecked="{Binding Range6h}" />
              <RadioButton Style="{StaticResource Button.Range}" GroupName="range" Content="24 horas" IsChecked="{Binding Range24h}" />
              <RadioButton Style="{StaticResource Button.Range}" GroupName="range" Content="7 días" IsChecked="{Binding Range7d}" Margin="0" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="¿Cómo ha estado tu conexión?" Style="{StaticResource Text.Section}" FontSize="16" />
              <TextBlock Text="{Binding MeasuredText}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
          </DockPanel>

          <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,-12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding ProblemsText}" Style="{StaticResource Text.Metric}" />
                <TextBlock Text="con problemas o sin conexión" Style="{StaticResource Text.Caption}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding UnstableText}" Style="{StaticResource Text.Metric}" />
                <TextBlock Text="inestable" Style="{StaticResource Text.Caption}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Text.Metric}" />
                <TextBlock Text="latencia promedio a internet" Style="{StaticResource Text.Caption}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding LossText}" Style="{StaticResource Text.Metric}" />
                <TextBlock Text="pérdida promedio" Style="{StaticResource Text.Caption}" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding WorstText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Text="Latencia hacia internet y estado por minuto" Style="{StaticResource Text.Section}" />
              </DockPanel>
              <Grid Height="260" Margin="0,10,0,0">
                <c:HistoryChart Rows="{Binding Rows}" From="{Binding From}" To="{Binding To}"
                                SeriesBrush="{DynamicResource Chart.Series}" GridBrush="{DynamicResource Chart.Grid}"
                                AxisBrush="{DynamicResource Chart.Axis}" TextBrush="{DynamicResource Fg.Muted}"
                                TooltipBackground="{DynamicResource Bg.Card}" TooltipForeground="{DynamicResource Fg.Primary}"
                                AutomationProperties.Name="Gráfica de latencia y estado de la conexión" />
                <TextBlock Text="Todavía no hay historial para este periodo. Se guarda un resumen cada minuto mientras la app está abierta."
                           Style="{StaticResource Text.Body}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
              </Grid>
              <WrapPanel Margin="44,8,0,0">
                <WrapPanel.Resources>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                    <Setter Property="Margin" Value="6,0,16,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                </WrapPanel.Resources>
                <Rectangle Width="16" Height="2" Fill="{DynamicResource Chart.Series}" VerticalAlignment="Center" />
                <TextBlock Text="Latencia promedio" />
                <ContentPresenter Content="{x:Static c:HealthValues.Good}" ContentTemplate="{StaticResource StatusBadge}" />
                <TextBlock Text="Buena" />
                <ContentPresenter Content="{x:Static c:HealthValues.Fair}" ContentTemplate="{StaticResource StatusBadge}" />
                <TextBlock Text="Inestable" />
                <ContentPresenter Content="{x:Static c:HealthValues.Poor}" ContentTemplate="{StaticResource StatusBadge}" />
                <TextBlock Text="Con problemas" />
                <ContentPresenter Content="{x:Static c:HealthValues.Down}" ContentTemplate="{StaticResource StatusBadge}" />
                <TextBlock Text="Sin conexión" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Cambios de estado" Style="{StaticResource Text.Section}" Margin="16,12,16,6" />
              <ListBox ItemsSource="{Binding Events}" BorderThickness="0" Background="Transparent" Margin="8,0,8,8"
                       VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Cambios de estado">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:EventItem}">
                    <Grid Margin="0,2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Fg.Secondary}" />
                      <ContentPresenter Grid.Column="1" Content="{Binding Severity}" ContentTemplate="{StaticResource StatusBadge}" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding SeverityLabel}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ======================= QUÉ HACER ======================= -->
      <TabItem Header="Qué hacer" Style="{StaticResource TabHeader}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Dashboard}" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Hero}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontSize="14" Margin="0,6,0,0" />

            <TextBlock Text="Pasos sugeridos, en orden" Style="{StaticResource Text.Section}" Margin="0,20,0,8"
                       Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="No hay nada que hacer en este momento: tu conexión funciona bien." Style="{StaticResource Text.Body}" Margin="0,16,0,0"
                       Visibility="{Binding HasSteps, Converter={StaticResource InverseBoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StepViewModel}">
                  <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent.Fg}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock x:Name="StepText" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                 Foreground="{DynamicResource Fg.Primary}" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="2" Content="Hecho" IsChecked="{Binding Done}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Done}" Value="True">
                      <Setter TargetName="StepText" Property="Foreground" Value="{DynamicResource Fg.Muted}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Herramientas" Style="{StaticResource Text.Section}" Margin="0,16,0,8" />
            <WrapPanel>
              <Button Style="{StaticResource Button.Primary}" Content="Compartir diagnóstico" Margin="0,0,8,8" Click="Share_Click" />
              <Button Style="{StaticResource Button.Secondary}" Content="Copiar resumen para Teams" Margin="0,0,8,8" Click="CopySummary_Click" />
              <Button Style="{StaticResource Button.Secondary}" Content="Configuración de Wi-Fi de Windows" Margin="0,0,8,8" Click="WifiSettings_Click" />
              <Button Style="{StaticResource Button.Secondary}" Content="Abrir página de inicio de sesión" Margin="0,0,8,8" Click="Captive_Click"
                      Visibility="{Binding IsCaptivePortal, Converter={StaticResource BoolToVis}}" />
              <Button Style="{StaticResource Button.Secondary}" Content="Contactar a soporte" Margin="0,0,8,8" Click="Support_Click"
                      DataContext="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="{Binding HasSupportContact, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
              «Compartir diagnóstico» crea un archivo .zip con el estado actual y el historial de tu conexión (sin archivos, sitios visitados ni contenido).
              Puedes adjuntarlo en Teams o en un correo a soporte.
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================= AVANZADO ======================= -->
      <TabItem Header="Avanzado" Style="{StaticResource TabHeader}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Datos técnicos" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Dashboard.Details}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:KeyValueItem}">
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Fg.Secondary}" TextWrapping="Wrap" />
                      <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                               Background="Transparent" Foreground="{DynamicResource Fg.Primary}" TextWrapping="Wrap" Padding="0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <CheckBox Content="Registro detallado" IsChecked="{Binding Settings.DetailedLog}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Style="{StaticResource Button.Secondary}" Content="Copiar" Click="CopyLog_Click" Margin="0,0,8,0" />
                  <Button Style="{StaticResource Button.Secondary}" Content="Carpeta de datos" Click="DataFolder_Click" />
                </StackPanel>
                <TextBlock Text="Registro" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
              </DockPanel>
              <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Background="Transparent" Margin="8,0,8,8"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                       AutomationProperties.Name="Registro técnico" />
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ======================= AJUSTES ======================= -->
      <TabItem Header="Ajustes" Style="{StaticResource TabHeader}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel DataContext="{Binding Settings}" MaxWidth="720" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="General" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />
                <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Iniciar con Windows" />
                    <TextBlock Text="La app queda junto al reloj, consume muy pocos recursos y te avisa si algo falla." Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock Text="Mostrar avisos cuando haya problemas" />
                    <TextBlock Text="Solo se avisa si el problema dura; nunca por cortes de un segundo." Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding CallDetectionEnabled}">
                  <StackPanel>
                    <TextBlock Text="Detectar llamadas y reuniones" />
                    <TextBlock Text="Cuando el micrófono está en uso, la app mide cada segundo y avisa más rápido. No escucha ni graba nada." Style="{StaticResource Text.Caption}" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Privacidad" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Text.Body}">
                  Todas las mediciones se guardan solo en este equipo. Nada se envía a ningún servidor.
                  Si necesitas ayuda, tú decides cuándo compartir el diagnóstico con «Compartir diagnóstico».
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource Button.Secondary}" Content="Abrir carpeta de datos" Click="DataFolder_Click" Margin="0,0,8,0" />
                  <Button Style="{StaticResource Button.Secondary}" Content="Permiso de ubicación (señal Wi-Fi)" Click="Location_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Acerca de" Style="{StaticResource Text.Section}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Body}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding UpdatesConfigured, Converter={StaticResource BoolToVis}}">
                  <Button Style="{StaticResource Button.Secondary}" Content="Buscar actualizaciones" Click="CheckUpdates_Click"
                          IsEnabled="{Binding IsChecking, Converter={x:Static c:InverseBoolConverter.Instance}}" />
                  <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
                  <Run Text="¿Necesitas ayuda? Contacta a " /><Run Text="{Binding SupportText, Mode=OneWay}" /><Run Text="." />
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
  </DockPanel>
</Window>
