<Window x:Class="InternetHealth.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:InternetHealth.App.Controls"
        Title="Monitor de Conexión"
        Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Fg.Primary}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="Manual" ShowActivated="True">
  <WindowChrome.WindowChrome>
    <!-- Mantiene la sombra y las esquinas redondeadas de Windows 11 sin barra de título -->
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource Border.Card}" BorderThickness="1">
    <StackPanel>
    <!-- Modo demostración: siempre visible para no confundir la red simulada con la real -->
    <Border Background="{DynamicResource Accent}" Padding="20,6"
            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
      <TextBlock Foreground="{DynamicResource Accent.Fg}" FontSize="12" TextWrapping="Wrap">
        <Run FontWeight="SemiBold" Text="Modo demostración:" /> <Run Text="red y llamada simuladas, no es tu conexión real." />
      </TextBlock>
    </Border>
    <StackPanel Margin="20,16,20,16">

      <!-- Encabezado -->
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" Click="Close_Click"
                ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar" />
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE713;" Click="Settings_Click"
                ToolTip="Ajustes" AutomationProperties.Name="Ajustes" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/InternetHealthMonitor;component/Assets/app.ico" Width="16" Height="16" Margin="0,0,8,0" />
          <TextBlock Text="Monitor de Conexión" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>

      <!-- Veredicto -->
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,14,0">
          <Ellipse Fill="{Binding Severity, Converter={StaticResource HealthBrush}}" />
          <TextBlock Text="{Binding Severity, Converter={StaticResource HealthGlyph}}" FontFamily="{StaticResource IconFont}" FontSize="18"
                     Foreground="{Binding Severity, Converter={StaticResource HealthBrush}, ConverterParameter=Ink}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding SeverityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Secondary}" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Hero}" Margin="0,1,0,0"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,4,0,0" />
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"
                     Visibility="{Binding IsImproving, Converter={StaticResource BoolToVis}}"
                     Text="Mejorando… confirmando que la conexión se mantenga estable" />
        </StackPanel>
      </Grid>

      <!-- Cadena -->
      <c:ChainView Margin="-6,18,-6,0" />

      <!-- Calidad para videollamadas -->
      <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,12">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MosText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" />
            <TextBlock Style="{StaticResource Text.Section}">
              <Run Text="Calidad para videollamadas: " /><Run Text="{Binding MosLabel, Mode=OneWay}" />
            </TextBlock>
          </DockPanel>
          <Grid Height="6" Margin="0,8,0,8">
            <Border CornerRadius="3" Background="{DynamicResource Bg.Subtle}" />
            <Border CornerRadius="3" HorizontalAlignment="Left" Background="{Binding Severity, Converter={StaticResource HealthBrush}}">
              <Border.Width>
                <MultiBinding Converter="{x:Static c:FractionToWidthConverter.Instance}">
                  <Binding Path="MosFraction" />
                  <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                </MultiBinding>
              </Border.Width>
            </Border>
          </Grid>
          <UniformGrid Columns="3">
            <StackPanel>
              <TextBlock Text="Latencia" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{Binding LatencyText}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Variación" Style="{StaticResource Text.Caption}" ToolTip="Jitter: qué tanto cambia la demora de un momento a otro. Afecta mucho las llamadas." />
              <TextBlock Text="{Binding JitterText}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Pérdida" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{Binding LossText}" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Qué hacer (solo si hay problema) -->
      <Border Margin="0,12,0,0" CornerRadius="8" Padding="14,12"
              Background="{Binding Severity, Converter={StaticResource HealthBrush}, ConverterParameter=Soft}"
              Visibility="{Binding HasSteps, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="Qué puedes hacer ahora" Style="{StaticResource Text.Section}" />
          <TextBlock Text="{Binding FirstStep}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Fg.Primary}" Margin="0,4,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Button.Secondary}" Content="Ver todos los pasos" Click="Steps_Click" />
            <Button Style="{StaticResource Button.Secondary}" Content="Abrir página de inicio de sesión" Margin="8,0,0,0" Click="Captive_Click"
                    Visibility="{Binding IsCaptivePortal, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Llamada en curso / permisos -->
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding InCall, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Text="{Binding CallText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" Visibility="{Binding LocationHint, Converter={StaticResource BoolToVis}}">
        <Run Text="Para ver la intensidad de la señal Wi-Fi, Windows pide permitir el acceso a la ubicación." />
        <Hyperlink Click="Location_Click">Activarlo</Hyperlink>
      </TextBlock>

      <!-- Acciones -->
      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Button.Secondary}" Content="Ver detalles" Click="Details_Click" />
        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="Compartir diagnóstico" Click="Share_Click"
                ToolTip="Crea un archivo con el diagnóstico para enviarlo a soporte" />
      </Grid>
      <DockPanel Margin="0,10,0,0">
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="No molestar activo"
                   Visibility="{Binding DndActive, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Text.Caption}" />
      </DockPanel>
    </StackPanel>
    </StackPanel>
  </Border>
</Window>
