<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:InternetHealth.Mac.Controls"
        xmlns:vm="using:InternetHealth.Presentation.ViewModels"
        xmlns:mon="using:InternetHealth.Core.Monitoring"
        x:Class="InternetHealth.Mac.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Monitor de Conexión"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <!-- Tarjeta de métrica con minigráfica -->
    <DataTemplate x:DataType="vm:MetricCardViewModel">
      <Border Classes="card" Margin="0,0,12,12" Padding="14,12">
        <StackPanel>
          <DockPanel>
            <c:StatusBadge DockPanel.Dock="Right" Health="{Binding Health}" />
            <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Primary}" Classes="metric" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Secondary}" Classes="body" />
          <c:Sparkline Height="42" Margin="0,8,0,0" Values="{Binding Values}"
                       Stroke="{DynamicResource Chart.Series}" LossBrush="{DynamicResource Chart.Loss}"
                       GridBrush="{DynamicResource Chart.Grid}" TextBrush="{DynamicResource Fg.Secondary}"
                       IsVisible="{Binding HasChart}"
                       ToolTip.Tip="Últimas mediciones. Las marcas rojas en la base son respuestas perdidas." />
          <TextBlock Text="{Binding Tertiary}" Classes="caption" Margin="0,6,0,0"
                     IsVisible="{Binding Tertiary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <!-- Modo demostración: siempre visible para no confundir la red simulada con la real -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Accent}" Padding="24,6" IsVisible="{Binding Dashboard.IsDemo}">
      <TextBlock Foreground="{DynamicResource Accent.Fg}" FontSize="12.5" TextWrapping="Wrap">
        <Run FontWeight="SemiBold" Text="Modo demostración:" />
        <Run Text="la red y la llamada son simuladas. Nada de lo que ves corresponde a tu conexión real." />
      </TextBlock>
    </Border>

    <TabControl Margin="24,8,24,16" SelectedIndex="{Binding SelectedTab}">

      <!-- ======================= RESUMEN ======================= -->
      <TabItem Header="Resumen">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,4,0">
          <StackPanel DataContext="{Binding Dashboard}" x:DataType="vm:DashboardViewModel">
            <Border Classes="card" Padding="20">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <c:StatusBadge Health="{Binding Severity}" Width="48" Height="48" VerticalAlignment="Top" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding SeverityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Secondary}" />
                  <TextBlock Text="{Binding Title}" Classes="hero" FontSize="22" />
                  <TextBlock Text="{Binding Summary}" Classes="body" FontSize="14" Margin="0,4,0,0" MaxWidth="640" HorizontalAlignment="Left" />
                  <TextBlock Classes="caption" Margin="0,8,0,0" Foreground="{DynamicResource Accent}" IsVisible="{Binding IsImproving}"
                             Text="Mejorando… confirmando que la conexión se mantenga estable" />
                  <TextBlock Text="{Binding CallText}" Classes="caption" Margin="0,8,0,0" IsVisible="{Binding InCall}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="24,0,0,0" MinWidth="200">
                  <TextBlock Text="Calidad para videollamadas" Classes="caption" />
                  <TextBlock Text="{Binding MosLabel}" Classes="metric" />
                  <TextBlock Text="{Binding MosText}" Classes="caption" />
                  <UniformGrid Columns="3" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="Latencia" Classes="caption" />
                      <TextBlock Text="{Binding LatencyText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Variación" Classes="caption" />
                      <TextBlock Text="{Binding JitterText}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="Pérdida" Classes="caption" />
                      <TextBlock Text="{Binding LossText}" FontWeight="SemiBold" />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card" Margin="0,12,0,0" Padding="16,18,16,14">
              <StackPanel>
                <TextBlock Text="Cadena de conexión" Classes="section" Margin="0,0,0,14" />
                <c:ChainView />
              </StackPanel>
            </Border>

            <TextBlock Text="Mediciones en vivo" Classes="section" Margin="0,20,0,10" />
            <UniformGrid Columns="3" Margin="0,0,-12,0">
              <ContentControl Content="{Binding InternetCard}" />
              <ContentControl Content="{Binding RouterCard}" />
              <ContentControl Content="{Binding ProviderCard}" />
              <ContentControl Content="{Binding CloudCard}" />
              <ContentControl Content="{Binding LinkCard}" />
              <ContentControl Content="{Binding DeviceCard}" />
            </UniformGrid>
            <TextBlock Classes="caption" Margin="0,0,0,8">
              <Run Text="{Binding UpdatedText}" /><Run Text=" · " /><Run Text="{Binding ModeText}" />
            </TextBlock>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================= HISTORIAL ======================= -->
      <TabItem Header="Historial">
        <Grid DataContext="{Binding History}" x:DataType="vm:HistoryViewModel" RowDefinitions="Auto,Auto,Auto,*" Margin="0,8,0,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton Classes="range" GroupName="range" Content="1 hora" IsChecked="{Binding Range1h}" />
              <RadioButton Classes="range" GroupName="range" Content="6 horas" IsChecked="{Binding Range6h}" />
              <RadioButton Classes="range" GroupName="range" Content="24 horas" IsChecked="{Binding Range24h}" />
              <RadioButton Classes="range" GroupName="range" Content="7 días" IsChecked="{Binding Range7d}" Margin="0" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="¿Cómo ha estado tu conexión?" Classes="section" FontSize="16" />
              <TextBlock Text="{Binding MeasuredText}" Classes="caption" />
            </StackPanel>
          </DockPanel>

          <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,-12,0">
            <Border Classes="card" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding ProblemsText}" Classes="metric" />
                <TextBlock Text="con problemas o sin conexión" Classes="caption" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding UnstableText}" Classes="metric" />
                <TextBlock Text="inestable" Classes="caption" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding LatencyText}" Classes="metric" />
                <TextBlock Text="latencia promedio a internet" Classes="caption" />
              </StackPanel>
            </Border>
            <Border Classes="card" Margin="0,0,12,0">
              <StackPanel>
                <TextBlock Text="{Binding LossText}" Classes="metric" />
                <TextBlock Text="pérdida promedio" Classes="caption" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding WorstText}" Classes="caption" VerticalAlignment="Center" />
                <TextBlock Text="Latencia hacia internet y estado por minuto" Classes="section" />
              </DockPanel>
              <Panel Height="260" Margin="0,10,0,0">
                <c:HistoryChart Rows="{Binding Rows}" From="{Binding From}" To="{Binding To}"
                                SeriesBrush="{DynamicResource Chart.Series}" GridBrush="{DynamicResource Chart.Grid}"
                                AxisBrush="{DynamicResource Chart.Axis}" TextBrush="{DynamicResource Fg.Muted}"
                                TooltipBackground="{DynamicResource Bg.Card}" TooltipForeground="{DynamicResource Fg.Primary}"
                                AutomationProperties.Name="Gráfica de latencia y estado de la conexión" />
                <TextBlock Text="Todavía no hay historial para este periodo. Se guarda un resumen cada minuto mientras la app está abierta."
                           Classes="body" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                           IsVisible="{Binding IsEmpty}" />
              </Panel>
              <WrapPanel Margin="44,8,0,0">
                <WrapPanel.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
                    <Setter Property="Margin" Value="6,0,16,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                  </Style>
                  <Style Selector="c|StatusBadge">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                  </Style>
                </WrapPanel.Styles>
                <Rectangle Width="16" Height="2" Fill="{DynamicResource Chart.Series}" VerticalAlignment="Center" />
                <TextBlock Text="Latencia promedio" />
                <c:StatusBadge Health="{x:Static c:HealthValues.Good}" />
                <TextBlock Text="Buena" />
                <c:StatusBadge Health="{x:Static c:HealthValues.Fair}" />
                <TextBlock Text="Inestable" />
                <c:StatusBadge Health="{x:Static c:HealthValues.Poor}" />
                <TextBlock Text="Con problemas" />
                <c:StatusBadge Health="{x:Static c:HealthValues.Down}" />
                <TextBlock Text="Sin conexión" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Classes="card" Margin="0,12,0,0" Padding="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Cambios de estado" Classes="section" Margin="16,12,16,6" />
              <ListBox Classes="compact" ItemsSource="{Binding Events}" Background="Transparent" Margin="8,0,8,8"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Cambios de estado">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventItem">
                    <Grid ColumnDefinitions="110,Auto,120,*">
                      <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" />
                      <c:StatusBadge Grid.Column="1" Health="{Binding Severity}" Width="18" Height="18" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="2" Text="{Binding SeverityLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ======================= QUÉ HACER ======================= -->
      <TabItem Header="Qué hacer">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel DataContext="{Binding Dashboard}" x:DataType="vm:DashboardViewModel">
              <TextBlock Text="{Binding Title}" Classes="hero" />
              <TextBlock Text="{Binding Summary}" Classes="body" FontSize="14" Margin="0,6,0,0" />

              <TextBlock Text="Pasos sugeridos, en orden" Classes="section" Margin="0,20,0,8" IsVisible="{Binding HasSteps}" />
              <TextBlock Text="No hay nada que hacer en este momento: tu conexión funciona bien." Classes="body" Margin="0,16,0,0"
                         IsVisible="{Binding !HasSteps}" />
              <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StepViewModel">
                    <Border Classes="card" Margin="0,0,0,8" Padding="14,12">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Accent.Fg}" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"
                                   Classes.done="{Binding Done}">
                          <TextBlock.Styles>
                            <Style Selector="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Fg.Primary}" />
                            </Style>
                            <Style Selector="TextBlock.done">
                              <Setter Property="Foreground" Value="{DynamicResource Fg.Muted}" />
                            </Style>
                          </TextBlock.Styles>
                        </TextBlock>
                        <CheckBox Grid.Column="2" Content="Hecho" IsChecked="{Binding Done}" VerticalAlignment="Center" Margin="12,0,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <TextBlock Text="Herramientas" Classes="section" Margin="0,16,0,8" />
            <WrapPanel>
              <WrapPanel.Styles>
                <Style Selector="Button">
                  <Setter Property="Margin" Value="0,0,8,8" />
                </Style>
              </WrapPanel.Styles>
              <Button Classes="primary" Content="Compartir diagnóstico" Click="Share_Click" />
              <Button Classes="secondary" Content="Copiar resumen para Teams" Click="CopySummary_Click" />
              <Button Classes="secondary" Content="Ajustes de Wi-Fi del Mac" Click="WifiSettings_Click" />
              <Button Classes="secondary" Content="Abrir página de inicio de sesión" Click="Captive_Click"
                      IsVisible="{Binding Dashboard.IsCaptivePortal}" />
              <Button Classes="secondary" Content="Contactar a soporte" Click="Support_Click"
                      IsVisible="{Binding Settings.HasSupportContact}" />
            </WrapPanel>
            <TextBlock Classes="caption" Margin="0,4,0,0"
                       Text="«Compartir diagnóstico» crea un archivo .zip con el estado actual y el historial de tu conexión (sin archivos, sitios visitados ni contenido). Puedes adjuntarlo en Teams o en un correo a soporte." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ======================= AVANZADO ======================= -->
      <TabItem Header="Avanzado">
        <Grid ColumnDefinitions="400,16,*" Margin="0,8,0,0">
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Datos técnicos" Classes="section" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Dashboard.Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KeyValueItem">
                    <Grid ColumnDefinitions="170,*" Margin="0,3">
                      <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Fg.Secondary}" TextWrapping="Wrap" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Foreground="{DynamicResource Fg.Primary}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" Padding="0">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <CheckBox Content="Registro detallado" IsChecked="{Binding Settings.DetailedLog}" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <Button Classes="secondary" Content="Copiar" Click="CopyLog_Click" />
                  <Button Classes="secondary" Content="Carpeta de datos" Click="DataFolder_Click" />
                </StackPanel>
                <TextBlock Text="Registro" Classes="section" VerticalAlignment="Center" />
              </DockPanel>
              <ListBox Classes="compact" ItemsSource="{Binding Log}" Background="Transparent" Margin="8,0,8,8"
                       FontFamily="Menlo, Monaco, monospace" FontSize="12" AutomationProperties.Name="Registro técnico">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="mon:LogEntry">
                    <TextBlock TextWrapping="Wrap">
                      <Run Text="{Binding Time, StringFormat='[{0:HH:mm:ss}]'}" /> <Run Text="{Binding Message}" />
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ======================= AJUSTES ======================= -->
      <TabItem Header="Ajustes">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
          <StackPanel DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" MaxWidth="720" HorizontalAlignment="Left">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="General" Classes="section" />
                <CheckBox IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Abrir al iniciar sesión en el Mac">
                  <StackPanel>
                    <TextBlock Text="Abrir al iniciar sesión en el Mac" />
                    <TextBlock Text="La app queda en la barra de menús, consume muy pocos recursos y te avisa si algo falla." Classes="caption" />
                  </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding NotificationsEnabled}" AutomationProperties.Name="Mostrar avisos cuando haya problemas">
                  <StackPanel>
                    <TextBlock Text="Mostrar avisos cuando haya problemas" />
                    <TextBlock Text="Solo se avisa si el problema dura; nunca por cortes de un segundo." Classes="caption" />
                  </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding CallDetectionEnabled}" AutomationProperties.Name="Detectar llamadas y reuniones">
                  <StackPanel>
                    <TextBlock Text="Detectar llamadas y reuniones" />
                    <TextBlock Text="Cuando el micrófono está en uso, la app mide cada segundo y avisa más rápido. No escucha ni graba nada." Classes="caption" />
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Privacidad" Classes="section" Margin="0,0,0,6" />
                <TextBlock Classes="body"
                           Text="Todas las mediciones se guardan solo en este equipo. Nada se envía a ningún servidor. Si necesitas ayuda, tú decides cuándo compartir el diagnóstico con «Compartir diagnóstico»." />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                  <Button Classes="secondary" Content="Abrir carpeta de datos" Click="DataFolder_Click" />
                  <Button Classes="secondary" Content="Permiso de ubicación (nombre de la red Wi-Fi)" Click="Location_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Acerca de" Classes="section" Margin="0,0,0,6" />
                <TextBlock Text="{Binding VersionText}" Classes="body" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsVisible="{Binding UpdatesConfigured}">
                  <Button Classes="secondary" Content="Buscar actualizaciones" Click="CheckUpdates_Click" IsEnabled="{Binding !IsChecking}" />
                  <TextBlock Text="{Binding UpdateStatus}" Classes="caption" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Classes="caption" Margin="0,10,0,0">
                  <Run Text="¿Necesitas ayuda? Contacta a " /><Run Text="{Binding SupportText}" /><Run Text="." />
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
