<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:InternetHealth.Mac.Controls"
             xmlns:vm="using:InternetHealth.Presentation.ViewModels"
             x:Class="InternetHealth.Mac.Controls.ChainView"
             x:DataType="vm:DashboardViewModel"
             Focusable="False">
  <!-- La cadena de conexión: el eslabón con problemas se resalta con un anillo grueso y la leyenda "Aquí falla". -->
  <ItemsControl ItemsSource="{Binding Chain}" AutomationProperties.Name="Cadena de conexión">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:ChainNodeViewModel">
        <Grid Margin="0,0,0,2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
              AutomationProperties.Name="{Binding AutomationName}" ToolTip.Tip="{Binding AutomationName}" Background="Transparent">
          <!-- Conectores -->
          <Rectangle Grid.Column="0" Height="2" VerticalAlignment="Center" Fill="{DynamicResource Chart.Axis}" IsVisible="{Binding !IsFirst}" />
          <Rectangle Grid.Column="1" Height="2" VerticalAlignment="Center" Fill="{DynamicResource Chart.Axis}" IsVisible="{Binding !IsLast}" />

          <!-- Nodo -->
          <Panel Grid.ColumnSpan="2" Width="46" Height="46" HorizontalAlignment="Center">
            <Border CornerRadius="23" BorderThickness="2" Classes.culprit="{Binding IsCulprit}"
                    Background="{Binding Health, Converter={StaticResource HealthBrush}, ConverterParameter=Soft}"
                    BorderBrush="{Binding Health, Converter={StaticResource HealthBrush}}">
              <Border.Styles>
                <Style Selector="Border.culprit">
                  <Setter Property="BorderThickness" Value="4" />
                </Style>
              </Border.Styles>
              <Path Data="{Binding IconKey, Converter={StaticResource ResourceByKey}}" Width="24" Height="24" Stretch="None"
                    StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="{DynamicResource Fg.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <c:StatusBadge Health="{Binding Health}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-4" />
          </Panel>

          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Label}" Margin="2,8,2,0" FontSize="12" FontWeight="SemiBold"
                     TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Fg.Primary}" />
          <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Margin="2,1,2,0" FontSize="11"
                     TextAlignment="Center" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Fg.Muted}" />
          <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5,0,0" HorizontalAlignment="Center" CornerRadius="4" Padding="6,1"
                  Background="{Binding Health, Converter={StaticResource HealthBrush}}" IsVisible="{Binding IsCulprit}">
            <TextBlock Text="Aquí falla" FontSize="10.5" FontWeight="SemiBold"
                       Foreground="{Binding Health, Converter={StaticResource HealthBrush}, ConverterParameter=Ink}" />
          </Border>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
