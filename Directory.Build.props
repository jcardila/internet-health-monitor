<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Authors>jcardila</Authors>
    <Company>Grupo Ardisa</Company>
    <Product>Monitor de Conexión</Product>
    <Copyright>Copyright (c) 2025-2026 jcardila - MIT License</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1305: el formato según la cultura del usuario (es-CO) es intencional en textos de interfaz. -->
    <NoWarn>$(NoWarn);CA1305;CA1822;CA1512;CA1848;CA2007;NU1900;WPF0001</NoWarn>
  </PropertyGroup>
</Project>
